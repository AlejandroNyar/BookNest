// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  description String?
  reviews     Review[] // Relación 1:N con reseñas
  createdAt   DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  reviews   Review[] // Relación 1:N con reseñas
  createdAt DateTime @default(now())
}


model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      // Por ejemplo, 1 a 5 estrellas
  comment   String?
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  book      Book     @relation(fields: [bookId], references: [id])
  bookId    Int
  createdAt DateTime @default(now())

  @@unique([userId, bookId]) // Un usuario no puede reseñar el mismo libro 2 veces
}